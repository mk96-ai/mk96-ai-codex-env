{
  "format": 1,
  "default_permissions": "mk96",
  "features.memories": false,
  "hooks": [
    {
      "event": "PreToolUse",
      "matcher": "Bash",
      "hook": {
        "command": "\"$HOME/.codex/hooks/git-guard/git-guard.sh\"",
        "timeout": 10,
        "type": "command"
      }
    },
    {
      "event": "PreToolUse",
      "matcher": "apply_patch",
      "hook": {
        "command": "\"$HOME/.codex/hooks/protect-files/protect-files.sh\"",
        "timeout": 10,
        "type": "command"
      }
    }
  ],
  "model": "gpt-5.5",
  "model_reasoning_effort": "medium",
  "permissions.mk96": {
    "description": "Like :workspace, plus environment files that sandboxed commands cannot read",
    "extends": ":workspace",
    "filesystem": {
      "glob_scan_max_depth": 6,
      ":workspace_roots": {
        "**/.env": "deny",
        "**/.env.*.local": "deny",
        "**/.env.local": "deny",
        "**/.env.development": "deny",
        "**/.env.production": "deny",
        "**/.env.staging": "deny",
        "**/.env.test": "deny"
      }
    }
  }
}
